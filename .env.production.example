# Database (Use a production PostgreSQL - Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# NextAuth Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="your-random-secret-key-here"

# Admin Credentials
ADMIN_EMAIL="admin@aibooks.com"
ADMIN_PASSWORD_HASH="\$2a\$10\$UeYVsUnfFfztPX1J5LlmnenNNGAzcjmvSce5wd1eHiqSQNb1mqzVi"

# Site URL (Your Vercel domain)
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Customer JWT Secret (Generate with: openssl rand -base64 32)
CUSTOMER_JWT_SECRET="your-customer-jwt-secret-here"
